# ==============================================================================
# NetPulse X - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the required values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/netpulse_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# Cache / Fast State Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail Configuration (SMTP / Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=NetPulse X Platform

# JWT Configuration
# Cryptographically secure HMAC-SHA 256-bit+ secret key (Base64 or plain string >= 32 characters)
JWT_SECRET=your_base64_or_32_plus_char_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws

